// linux:
//> linux: include: ./raylib-linux
//> linux: lib: ./raylib-linux
//> linux: link: -lraylib -lm

// windows:
//> windows: include: ./raylib-win
//> windows: lib: ./raylib-win
//> windows: link: -lraylibdll -lm

import "raylib.h"
import "std/vec.zc"
import "std/math.zc"

def MAX_PARTICLES = 10000;
def GRAVITY = 100.f;
def PARTICLE_MAX_SPEED = 300.f;
def PARTICLE_FRICTION = 0.5f;
def PARTICLE_RADIUS = 5.0f;
def PARTICLES_PER_BOOM = 100;

// Define the Particle struct
struct Particle {
    position: Vector2;
    velocity: Vector2;
    color: Color;
    alpha: float;
    size: float;
    life: float;
}

// Global arrays for particles
let particles: Particle[MAX_PARTICLES];
let particleCount: int = 0;

// Function to update particle physics
fn UpdateParticles() {
    let dt = GetFrameTime();

    for i in 0..particleCount {
        // Apply gravity and friction
        particles[i].velocity.x = particles[i].velocity.x / (1 + PARTICLE_FRICTION * dt);
        particles[i].velocity.y = particles[i].velocity.y / (1 + PARTICLE_FRICTION * dt);
        particles[i].velocity.y += GRAVITY * dt;
        particles[i].velocity.y = Math::min(particles[i].velocity.y, PARTICLE_MAX_SPEED);

        // Update position
        particles[i].position.x += particles[i].velocity.x * dt;
        particles[i].position.y += particles[i].velocity.y * dt;

        // Update life and alpha
        particles[i].life -= dt;
        particles[i].size = particles[i].life * PARTICLE_RADIUS;
        particles[i].alpha = particles[i].life * 255.0f;
    }

    // Remove dead particles (Move semantics)
    for i in particleCount-1..0 step -1 {
        if particles[i].life <= 0.0f {
            particles[i] = particles[particleCount - 1];
            particleCount -= 1;
        }
    }
}

// Function to draw particles
fn DrawParticles() {
    for i in 0..particleCount {
        let drawColor = ColorAlpha(particles[i].color, particles[i].alpha);
        DrawCircleV(particles[i].position, particles[i].size, drawColor);
    }
}

// Function to launch a firework explosion
fn LaunchFirework() {
    if particleCount < MAX_PARTICLES - PARTICLES_PER_BOOM {
        // Start from bottom center
        let startPos = Vector2 {
            x: GetRandomValue(50, (float) GetScreenWidth() - 50),
            y: GetRandomValue(50, (float) GetScreenHeight() / 2)
        };

        let color = Color {
            r: GetRandomValue(50, 255),
            g: GetRandomValue(50, 255),
            b: GetRandomValue(50, 255),
            a: 255
        };

        for i in 0..PARTICLES_PER_BOOM {
            // Random angle and speed
            let angle = (float) GetRandomValue(0, 360) * DEG2RAD;
            let speed = (float) GetRandomValue(20, 100) / 100 * PARTICLE_MAX_SPEED;

            // Create particle
            let p = Particle {
                position: startPos,
                velocity: Vector2 {
                    x: Math::cos(angle) * speed,
                    y: Math::sin(angle) * speed
                },
                color: color,
                alpha: 255.0f,
                size: PARTICLE_RADIUS,
                life: 1.0f
            };

            particles[particleCount] = p;
            particleCount += 1;
        }
    }
}

fn main() {
    SetConfigFlags(FLAG_WINDOW_RESIZABLE | FLAG_WINDOW_MINIMIZED | FLAG_WINDOW_MAXIMIZED | FLAG_VSYNC_HINT | FLAG_MSAA_4X_HINT);
    InitWindow(1280, 720, "Zen-C Fireworks");
    SetWindowMinSize(1280, 720);
    MaximizeWindow();

    let maxFPS = GetMonitorRefreshRate(GetCurrentMonitor());
    // SetTargetFPS(maxFPS);

    while (!WindowShouldClose()) {
        // Update
        let chance = 10;
        if (IsKeyDown(KEY_SPACE)) {
            chance = 90;
        }

        if (GetRandomValue(0, 100) < chance) {
            LaunchFirework();
        }

        UpdateParticles();

        // Draw
        BeginDrawing();
        ClearBackground(BLACK);
        
        DrawText(f"{GetFPS()} / {maxFPS} FPS | {GetFrameTime()} dt | {particleCount} obj", 5, 5, 16, DARKGRAY);
        DrawText("Hold SPACE to launch", 20, GetScreenHeight() - 20, 16, DARKGRAY);

        def banner_text = "Zen-C Community Edition!";
        def banner_size = 85;
        let color = Color {
            r: GetRandomValue(50, 255),
            g: GetRandomValue(50, 255),
            b: GetRandomValue(50, 255),
            a: 255
        };
        DrawText(banner_text, Math::floor((GetScreenWidth() - MeasureText(banner_text, banner_size)) / 2), GetScreenHeight() - 150, banner_size, color);

        DrawParticles();

        EndDrawing();
    }
    CloseWindow();
    return 0;
}
